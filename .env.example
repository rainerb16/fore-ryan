# Copy to .env for local development. .env is gitignored — never commit it.
# In production these are set in Netlify under Site configuration ->
# Environment variables, and .env is not used at all.

# Supabase -> Project Settings -> Data API
SUPABASE_URL=https://your-project.supabase.co

# Supabase -> Project Settings -> API Keys -> secret key (sb_secret_...).
# Bypasses row level security. Server only, never in client code.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Any long random string, generated once: openssl rand -hex 32
# Must match the value set in Netlify, or local and deployed runs will hash
# the same email to different people.
EMAIL_HASH_SALT=replace_me

# Optional. When the contest closes, as an ISO timestamp — after this, runs can
# no longer be started or posted, but the standings stay readable. Leave unset
# to run indefinitely.
# CONTEST_ENDS_AT=2026-09-30T23:59:59Z
